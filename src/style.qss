* { font-family: "Microsoft YaHei UI"; font-size: 13px; color: ${text}; }
QMainWindow, QDialog { background: ${window}; }
QWidget#surface, QWidget#scroll-content, QScrollArea, QScrollArea > QWidget, QScrollArea > QWidget > QWidget, QStackedWidget, QStackedWidget > QWidget { background: transparent; }
QFrame#header { background: ${header}; border: none; border-bottom: 1px solid ${border}; }
QLabel { background: transparent; }
QLabel#product { color: ${header_text}; font-size: 22px; font-weight: 700; }
QLabel#headnote { color: ${header_muted}; font-size: 12px; }
QLabel#connection { background: ${chip}; color: ${text}; padding: 6px 12px; border-radius: 12px; border: 1px solid ${border}; }
QFrame#card, QFrame#toolbar, QFrame#guide { background: ${card}; border: 1px solid ${border}; border-radius: 13px; }
QFrame#nav { background: ${nav}; border: 1px solid ${border}; border-radius: 10px; }
QFrame#tuneCard, QFrame#metrics { background: ${tune}; border: 1px solid ${border}; border-radius: 8px; }
QLabel#section { font-size: 17px; color: ${section}; font-weight: 700; }
QLabel#muted { color: ${muted}; font-size: 12px; }
QLabel#metric { color: ${accent_text}; font-size: 15px; font-weight: 700; }
QLabel#bigValue { color: ${text}; font-size: 20px; font-weight: 700; }
QLabel#bigName { color: ${muted}; font-size: 11px; }
QLabel#motorState { font-size: 12px; font-weight: 700; padding: 4px 10px; border-radius: 10px; background: ${idle_bg}; color: ${idle_text}; }
QLabel#motorState[state="running"] { background: ${ok_bg}; color: ${ok_text}; }
QLabel#motorState[state="busy"] { background: ${busy_bg}; color: ${busy_text}; }
QLabel#motorState[state="fault"] { background: ${fault_bg}; color: ${fault_text}; }
QLabel#inlineNote { background: ${note_bg}; color: ${note_text}; border: 1px solid ${border}; border-radius: 7px; padding: 8px; font-size: 12px; }
QLabel#alert { color: ${danger}; font-weight: 600; }
QLabel#guideStep { color: ${muted}; font-size: 12px; padding: 3px 8px; border-radius: 9px; }
QLabel#guideStep[stage="done"] { color: ${ok_text}; }
QLabel#guideStep[stage="now"] { color: ${accent_on}; background: ${accent}; font-weight: 700; }
QLabel#guideHint { color: ${text}; font-size: 13px; }
QPushButton { color: ${text}; background: ${button}; min-height: 30px; border: 1px solid ${border}; border-radius: 7px; padding: 0 12px; }
QPushButton:hover { background: ${button_hover}; border-color: ${accent}; }
QPushButton:pressed { background: ${button_pressed}; }
QPushButton:checked { background: ${accent_soft}; border-color: ${accent}; }
QPushButton:disabled { color: ${disabled_text}; border-color: ${border}; background: ${disabled_bg}; }
QPushButton#primary, QPushButton#guideAction { color: ${accent_on}; background: ${accent}; border-color: ${accent}; font-weight: 600; }
QPushButton#primary:hover, QPushButton#guideAction:hover { background: ${accent_hover}; }
QPushButton#primary:disabled, QPushButton#guideAction:disabled { color: ${disabled_text}; background: ${disabled_bg}; border-color: ${border}; }
QPushButton#stop { color: #ffffff; font-weight: 700; background: ${danger}; border-color: ${danger}; min-height: 34px; }
QPushButton#stop:hover { background: ${danger_hover}; }
QPushButton#stop:disabled { color: ${disabled_text}; background: ${disabled_bg}; border-color: ${border}; }
QPushButton#headerTool { min-height: 30px; padding: 0 10px; background: ${chip}; }
QPushButton[tab="true"] { background: transparent; border: 1px solid transparent; color: ${muted}; font-weight: 600; min-height: 32px; }
QPushButton[tab="true"]:hover { background: ${button_hover}; }
QPushButton[tab="true"]:checked { background: ${accent_soft}; border-color: ${accent}; color: ${text}; }
QComboBox, QSpinBox, QDoubleSpinBox, QLineEdit, QTextBrowser { min-height: 29px; border: 1px solid ${border}; border-radius: 6px; background: ${field}; padding: 0 5px; selection-background-color: ${accent}; selection-color: ${accent_on}; }
QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus, QLineEdit:focus { border-color: ${accent}; }
QComboBox:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled, QLineEdit:disabled { background: ${disabled_bg}; color: ${disabled_text}; }
QDoubleSpinBox[dirty="true"], QLineEdit[dirty="true"] { background: ${dirty_bg}; }
QLabel#toast { background: ${menu}; color: ${text}; border: 1px solid ${accent}; border-radius: 10px; padding: 10px 16px; font-size: 13px; }
QLabel#toast[error="true"] { border: 2px solid ${danger}; color: ${danger}; font-weight: 600; }
QTreeWidget { border: 1px solid ${border}; border-radius: 7px; background: ${field}; alternate-background-color: ${field_alt}; selection-background-color: ${accent_soft}; selection-color: ${text}; }
QComboBox QAbstractItemView { background: ${menu}; border: 1px solid ${border}; selection-background-color: ${accent}; selection-color: ${accent_on}; }
QCheckBox { spacing: 6px; background: transparent; }
QCheckBox::indicator { width: 14px; height: 14px; background: ${field}; border: 1px solid ${border_strong}; border-radius: 3px; }
QCheckBox::indicator:checked { background: ${accent}; border-color: ${accent}; }
QTableWidget { gridline-color: ${border}; background: ${field}; alternate-background-color: ${field_alt}; border: 1px solid ${border}; border-radius: 7px; selection-background-color: ${accent_soft}; selection-color: ${text}; }
QHeaderView::section { background: ${table_head}; color: ${text}; font-weight: 600; min-height: 26px; border: 0; padding: 3px; }
QSlider::groove:horizontal { height: 4px; border-radius: 2px; background: ${border}; }
QSlider::sub-page:horizontal { background: ${accent}; border-radius: 2px; }
QSlider::handle:horizontal { background: ${accent}; width: 12px; margin: -4px 0; border-radius: 6px; }
QScrollArea { border: 0; }
QScrollBar:vertical { background: transparent; width: 9px; margin: 0; }
QScrollBar:horizontal { background: transparent; height: 9px; margin: 0; }
QScrollBar::handle:vertical, QScrollBar::handle:horizontal { background: ${scroll}; min-height: 18px; min-width: 18px; border-radius: 4px; }
QScrollBar::add-line, QScrollBar::sub-line { height: 0px; width: 0px; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }
QProgressBar { background: ${border}; border: 0; border-radius: 3px; max-height: 5px; }
QProgressBar::chunk { background: ${accent}; border-radius: 3px; }
QToolTip { background: ${menu}; color: ${text}; border: 1px solid ${accent}; padding: 4px; }
QMenu { background: ${menu}; border: 1px solid ${border}; padding: 4px; }
QMenu::item { padding: 5px 24px 5px 10px; }
QMenu::item:selected { background: ${accent}; color: ${accent_on}; }
